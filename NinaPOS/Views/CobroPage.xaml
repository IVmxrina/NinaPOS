<ContentPage
    x:Class="NinaPOS.Views.CobroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:NinaPOS.ViewModels"
    xmlns:controls="clr-namespace:NinaPOS.Views.Controls"
    x:DataType="vm:CobroViewModel">

    <Grid RowDefinitions="auto,1*,auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="auto,*" BackgroundColor="LightGray" Padding="10,5">
            <Grid Grid.Column="0">
                <Button Text="☰" HeightRequest="64" WidthRequest="64"
                        BackgroundColor="Transparent" TextColor="Black" FontSize="28"/>
            </Grid>
        </Grid>

        <!-- Cuerpo -->
        <Grid Grid.Row="1" BackgroundColor="LightGray" Padding="15">
            <Grid ColumnDefinitions="2*,1.5*" ColumnSpacing="15">

                <!-- Ticket de solo lectura -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 15"
                        StrokeThickness="0" BackgroundColor="White">
                    <Grid RowDefinitions="*,auto">
                        <controls:ListaTicket Grid.Row="0"
                            Items="{Binding Items}" Editable="False" />
                        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" >
                            <Label
                               Text="{Binding TotalAPagar, StringFormat='Total: {0:C2}'}"
                               FontSize="32" FontAttributes="Bold"
                               Padding="20,15" />
                            <Label
                               Text="{Binding CantidadRestante, StringFormat='Restante: {0:C2}'}"
                               FontSize="25" FontAttributes="Bold"
                               Padding="20,15" />
                        </HorizontalStackLayout>
                        
                        
                    </Grid>
                </Border>

                <!-- Columna 2: entrada de pago -->
                <!-- TODO: añadir teclado numerico y modificar el proceso de cobro -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                    <Grid RowDefinitions="*,3*,*" BackgroundColor="White">

                        <Grid Grid.Row="0" Padding="15">
                            <Entry x:Name="InputDinero"
                                    Placeholder="Dinero entregado"
                                   Text="{Binding CantidadIntroducida}"
                                   Keyboard="Numeric" FontSize="20" HeightRequest="64" />
                        </Grid>

                        <Grid Grid.Row="1" Padding="15" ColumnDefinitions="3*, *">
                            <controls:TecladoNumerico Grid.Column="0" Texto="{Binding Source={x:Reference InputDinero}, Path=Text}" />
                            <Grid Grid.Column="1" RowDefinitions="*, *, *, *" RowSpacing="8" Padding="0, 15">
                                <Button Grid.Row="0" Grid.Column="1" Text="Tarjeta" FontSize="20"
                                        Clicked="OnTarjetaClicked" CommandParameter="tarjeta"/>
                                <Button Grid.Row="1" Grid.Column="1" Text="Efectivo" FontSize="20"
                                        Clicked="OnEfectivoClicked"
                                         CommandParameter="efectivo"/>
                                <Button Grid.Row="2" Grid.Column="1" Text="Anular" FontSize="20"
                                        Command="{Binding AnularTransaccionCommand}"
                                        IsVisible="{Binding AnularVisible}"/>
                            </Grid>
                        </Grid>

                        <!-- Misma fila de botones que MainPage, pero con roles distintos -->
                        <Grid Grid.Row="2" Padding="15" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Confirmar"
                                    HeightRequest="64" FontSize="20"
                                    BackgroundColor="Green" TextColor="White" />
                            <Button Grid.Column="1" Text="Total"
                                    Command="{Binding VolverATicketCommand}"
                                    HeightRequest="64" FontSize="20"
                                    BackgroundColor="Orange" TextColor="White" />
                        </Grid>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>