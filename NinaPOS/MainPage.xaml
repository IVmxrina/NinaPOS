<ContentPage
    x:Class="NinaPOS.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="auto, 1*, auto">

        <!-- Header de encima-->
        <Grid Grid.Row="0" ColumnDefinitions="auto, *" BackgroundColor="LightGray" Padding="10, 5">
            <Grid Grid.Column="0">
                <Button
                Text="☰"
                HeightRequest="64" WidthRequest="64"
                BackgroundColor="Transparent"
                TextColor="Black" FontSize="28"/>
            </Grid>

            <Grid Grid.Column="1">
                
            </Grid>

            <Grid Grid.Column="2">
                <Label Text="Usuario"
                       FontSize="18"
                       Padding="20"/>
            </Grid>
            
        </Grid>

        <!-- Cuerpo de la pantalla principal-->
        <Grid Grid.Row="1" BackgroundColor="LightGray" Padding="15">
            <Grid ColumnDefinitions="2*, 1.5*" ColumnSpacing="15">

                <!-- Columna 1 -->
                <Border Grid.Column="0" 
                        StrokeShape="RoundRectangle 15" 
                        StrokeThickness="0" 
                        BackgroundColor="White">
                    <Grid Grid.Column="0" 
                          RowDefinitions="*, auto">

                        <CollectionView Grid.Row="0"
                                            ItemsSource="{Binding Items}"
                                            SelectedItem="{Binding ItemSeleccionado}"
                                            SelectionMode="Single">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="3*,2*,1*,Auto"
                                          Padding="15" 
                                          MinimumHeightRequest="64">

                                        <Label Text="{Binding Nombre}"
                                               VerticalOptions="Center" FontSize="18" />

                                        <!-- Columna de cantidad con -/+ -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Button Text="-"
                                            WidthRequest="44" HeightRequest="44" FontSize="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DisminuirCantidadCommand}"
                                            CommandParameter="{Binding .}" />

                                            <Label Text="{Binding Cantidad}"
                                           FontSize="18" VerticalOptions="Center"
                                           HorizontalOptions="Center" WidthRequest="32"
                                           HorizontalTextAlignment="Center" />

                                            <Button Text="+"
                                            WidthRequest="44" HeightRequest="44" FontSize="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AumentarCantidadCommand}"
                                            CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='{0:C2}'}"
                                        VerticalOptions="Center" FontSize="18" />

                                        <Button Grid.Column="3" Text="✕"
                                        WidthRequest="64" HeightRequest="64"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarItemCommand}"
                                        CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>


                        <Label Grid.Row="1"
                           Text="{Binding Total, StringFormat='Total: {0:C2}'}"
                           FontSize="32" FontAttributes="Bold"
                           HorizontalOptions="End" Padding="20 50" />
                    </Grid>
                </Border>

                <!-- Columna 2 -->
                <Border Grid.Column="1" 
                        StrokeShape="RoundRectangle 15" 
                        StrokeThickness="0">
                    <Grid RowDefinitions="*, 3*, *" BackgroundColor="White">
                        <Grid  Grid.Row="0" Padding="15">
                            <!--<Entry Placeholder="Cantidad"
                               Text="{Binding CantidadPrevia}"
                               Keyboard="Numeric"
                               FontSize="20" HeightRequest="64" /> -->

                            <Entry Placeholder="Codigo de barras"
                                    Text="{Binding CodigoIngresado}"
                                    FontSize="20" HeightRequest="64"
                                    ReturnCommand="{Binding EscanearProductoCommand}" />
                        </Grid>

                        <!-- Calculadora / teclado numérico -->
                        <Grid Grid.Row="1"
                              RowDefinitions="*,*,*,*"
                              ColumnDefinitions="*,*,*"
                              RowSpacing="8" ColumnSpacing="8"
                              Padding="15">

                            <Button Grid.Row="0" Grid.Column="0" Text="1" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="0" Grid.Column="1" Text="2" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="0" Grid.Column="2" Text="3" FontSize="20" Clicked="OnDigitClicked"/>

                            <Button Grid.Row="1" Grid.Column="0" Text="4" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="1" Grid.Column="1" Text="5" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="1" Grid.Column="2" Text="6" FontSize="20" Clicked="OnDigitClicked"/>

                            <Button Grid.Row="2" Grid.Column="0" Text="7" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="2" Grid.Column="1" Text="8" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="2" Grid.Column="2" Text="9" FontSize="20" Clicked="OnDigitClicked"/>

                            <Button Grid.Row="3" Grid.Column="0" Text="x" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="3" Grid.Column="1" Text="0" FontSize="20" Clicked="OnDigitClicked"/>
                            <Button Grid.Row="3" Grid.Column="2" Text="⌫" FontSize="20" Clicked="OnBorrarUltimoClicked"/>

                        </Grid>

                        <!-- Botones cobro -->
                        <Grid Grid.Row="2" Padding="15" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Enter"
                                    Command="{Binding EscanearProductoCommand}"
                                    HeightRequest="64" FontSize="20" />
                            <Button Grid.Column="1" Text="Total"
                                    Command="{Binding CobrarCommand}"
                                    HeightRequest="64" FontSize="20"
                                    BackgroundColor="Green" TextColor="White" />
                        </Grid>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
        
        
    </Grid>
</ContentPage>